# YouTube SEO Tool Environment Variables
# Copy this file to .env and fill in your actual values

# Required: Groq API Key for AI functionality
GROQ_API_KEY=your_groq_api_key_here

# Required: YouTube API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Required for production: PayPal integration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_MODE=live

# Database Configuration (Neon PostgreSQL)
# Get your connection string from Neon Console: https://console.neon.tech/
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=your_neon_connection_string_here

# Error Tracking (Optional but recommended)
SENTRY_DSN=your_sentry_dsn_here

# Application Settings
NODE_ENV=development
LOG_LEVEL=info