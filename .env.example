# YouTube SEO Tool Environment Variables
# Copy this file to .env and fill in your actual values

# Required: Groq API Key for AI functionality
GROQ_API_KEY=your_groq_api_key_here

# Required: YouTube API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional: Google API key for CrUX field data (Core Web Vitals)
# Enables scripts/fetch-crux-field-data.mjs to pull real-world LCP/INP/CLS,
# so audits score Performance from field data instead of lab signals.
# 1. Google Cloud Console -> Enable "Chrome UX Report API"
# 2. APIs & Services -> Credentials -> Create API Key
# 3. Set in Vercel: vercel env add GOOGLE_API_KEY
# GOOGLE_API_KEY=your_google_api_key_here

# Required for production: PayPal integration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_MODE=live

# Database Configuration (Neon PostgreSQL)
# Get your connection string from Neon Console: https://console.neon.tech/
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=your_neon_connection_string_here

# Error Tracking (Optional but recommended)
SENTRY_DSN=your_sentry_dsn_here

# Backlink Automation - Email (required for broken link outreach + HARO)
# Use Gmail App Password: Google Account → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Patrick <your@gmail.com>"

# Backlink Automation - IMAP (required for HARO query monitoring)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your@gmail.com
IMAP_PASS=your_app_password

# Google Indexing API (required for instant page indexing)
# 1. Go to console.cloud.google.com → Enable Indexing API
# 2. Create Service Account → Download JSON key
# 3. Add service account email as Owner in Search Console
# 4. Save JSON key to config/google-indexing-key.json
# (OR set GOOGLE_INDEXING_KEY to full path of JSON file)
# GOOGLE_INDEXING_KEY=config/google-indexing-key.json

# HARO automation settings
HARO_SENDERS=connectively.us,helpareporter.com
YOUR_NAME=Patrick
YOUR_SITE=https://yt-seo-architect.vercel.app
YOUR_TOOL=YT SEO Architect

# Application Settings
NODE_ENV=development
LOG_LEVEL=info