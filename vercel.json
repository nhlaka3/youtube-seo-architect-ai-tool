{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "includeFiles": ["scripts/glossary-data.json"] } },
    { "src": "api/[...path].js", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "design-tokens.css", "use": "@vercel/static" },
    { "src": "utilities.css", "use": "@vercel/static" },
    { "src": "nav.css", "use": "@vercel/static" },
    { "src": "blog-article.css", "use": "@vercel/static" },
    { "src": "tools.html", "use": "@vercel/static" }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-growth-pulse",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-agent-loop",
      "schedule": "0 7 * * *"
    }
  ],
  "redirects": [
    { "source": "/pricing", "destination": "/dashboard.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/index.js" },
    { "source": "/robots.txt", "destination": "/api/index.js" },
    { "source": "/blog", "destination": "/api/index.js" },
    { "source": "/blog/(.+)", "destination": "/api/index.js" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/changelog", "destination": "/changelog.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/seo-lab", "destination": "/seo-lab.html" },
    { "source": "/lab", "destination": "/seo-lab.html" },
    { "source": "/tools/tag-generator", "destination": "/tools/tag-generator.html" },
    { "source": "/tools/title-optimizer", "destination": "/tools/title-optimizer.html" },
    { "source": "/tools/description-writer", "destination": "/tools/description-writer.html" },
    { "source": "/tools/converters", "destination": "/tools/converters/index.html" },
    { "source": "/tools/converters/(.*)", "destination": "/tools/converters/$1.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/guides/(.*)", "destination": "/guides/$1.html" },
    { "source": "/tools/(.*)", "destination": "/tools/$1.html" },
    { "source": "/glossary/(.+)", "destination": "/api/index.js" },
    { "source": "/guide/youtube-seo", "destination": "/api/index.js" },
    { "source": "/vs/morningfame", "destination": "/vs/morningfame.html" },
    { "source": "/vs/tubics", "destination": "/vs/tubics.html" },
    { "source": "/vs/keywordtool", "destination": "/vs/keywordtool.html" },
    { "source": "/vs/canva", "destination": "/vs/canva.html" },
    { "source": "/vs", "destination": "/vs/index.html" },
    { "source": "/vs/(.*)", "destination": "/vs/$1.html" },

    { "source": "/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [{
        "key": "Content-Security-Policy",
        "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://www.paypal.com https://www.sandbox.paypal.com https://*.paypal.com https://*.paypalobjects.com https://static.cloudflareinsights.com https://unpkg.com https://apis.google.com https://accounts.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; img-src 'self' data: https: blob: https://*.paypalobjects.com https://*.paypal.com; media-src 'self' data: blob:; connect-src 'self' https://api.groq.com https://www.googleapis.com https://*.googleapis.com https://youtubeanalytics.googleapis.com https://noembed.com https://api-m.paypal.com https://api-m.sandbox.paypal.com https://*.paypal.com https://unpkg.com https://*.sentry.io https://*.google-analytics.com https://*.cloudflareinsights.com; frame-src 'self' https://js.stripe.com https://www.paypal.com https://www.sandbox.paypal.com https://*.paypal.com https://*.paypalobjects.com https://accounts.google.com blob:; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self' https://*.paypal.com https://www.paypal.com https://www.sandbox.paypal.com;"
      }]
    }
  ]
}
