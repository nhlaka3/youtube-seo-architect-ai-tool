{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "scripts/glossary-data.json"
        ]
      }
    },
    {
      "src": "api/[...path].js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "tools.html",
      "use": "@vercel/static"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-growth-pulse",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-agent-loop",
      "schedule": "0 7 * * *"
    }
  ],
